{
  "name": "splendor-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, real-time multiplayer Splendor for playing with friends.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "node scripts/next-build.mjs",
    "start": "tsx server/index.ts",
    "host": "npm run build && npm run start --",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "data:import-sources": "tsx scripts/card-data/import-sources.ts",
    "data:build-pack": "tsx scripts/card-data/build-base-pack.ts",
    "admin:reset": "node -e \"require('node:fs').rmSync('var/admin-secret.hash',{force:true});console.log('Host secret removed. A new one is printed the next time the server starts.')\""
  },
  "dependencies": {
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <=11.0.0": "11.0.5"
  }
}
